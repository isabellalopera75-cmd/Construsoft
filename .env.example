# Plantilla de variables de entorno. NO contiene contraseñas y no debe
# contenerlas nunca: este archivo sí se versiona (.gitignore lo permite con
# !.env.example), mientras que .env y .env.test quedan excluidos.
#
# Para usarla: copia este archivo como .env.test y llena los valores vacíos
# con las contraseñas que tú mismo pusiste con \password.

# --- Conexión de la aplicación (app_login) --------------------------------
# Trabaja siempre dentro del contexto de una empresa. No tiene BYPASSRLS y no
# alcanza fn_autenticar: si lo intenta, la base la rechaza (D-46).
APP_DB_HOST=localhost
APP_DB_PORT=5432
APP_DB_NAME=construsoft_test
APP_DB_USER=app_login
APP_DB_PASSWORD=

# --- Conexión de autenticación (auth_login) -------------------------------
# Existe solo para resolver el login, antes de que haya contexto de empresa.
# Es miembro de construsoft_autenticador, nunca de construsoft_auth (D-50).
AUTH_DB_HOST=localhost
AUTH_DB_PORT=5432
AUTH_DB_NAME=construsoft_test
AUTH_DB_USER=auth_login
AUTH_DB_PASSWORD=

# --- Superusuario, solo para rehacer la base de pruebas -------------------
# Lo usa scripts/resetear-base-pruebas.sh y nada más. La aplicación jamás se
# conecta con estas credenciales.
#
# CUIDADO con TEST_SUPERUSER_DB: es la base que el script BORRA y vuelve a
# crear en cada corrida de pruebas. Tiene que decir construsoft_test. Si
# alguna vez dice construsoft, la siguiente corrida se lleva por delante tu
# base de desarrollo.
TEST_SUPERUSER_HOST=localhost
TEST_SUPERUSER_PORT=5432
TEST_SUPERUSER_DB=construsoft_test
TEST_SUPERUSER_USER=postgres
TEST_SUPERUSER_PASSWORD=

# --- La API web (npm run api) ---------------------------------------------
# SESSION_SECRET firma la cookie de sesión. Larga y aleatoria, no una frase.
# Cambiarla cierra todas las sesiones abiertas: es también el botón de pánico.
SESSION_SECRET=

# La versión de los términos publicados, que se guarda con cada aceptación.
# Mientras el texto no haya pasado por un abogado se llama PROVISIONAL-<fecha>,
# y entonces la API se niega a arrancar salvo que las dos siguientes estén
# puestas a mano (04 §8.6). Olvidarse de configurar algo no arranca.
VERSION_TERMINOS=

# Exactamente «si» para autorizar el arranque con términos provisionales.
# Cualquier otro valor detiene la API. No depende de NODE_ENV.
TERMINOS_PROVISIONALES=

# A quién escribir, que la página provisional muestra. Obligatoria en ese modo.
CONTACTO_TERMINOS=

# La dirección o la subred del proxy concreto, cuando haya uno delante.
# NUNCA «true»: con true, Fastify cree cualquier X-Forwarded-For y el límite de
# intentos por IP deja de existir. La API rechaza ese valor al arrancar.
PROXIES_DE_CONFIANZA=
